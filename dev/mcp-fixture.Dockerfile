FROM golang:1.26.10-alpine@sha256:5cb67f19c5e7994dcb80c074f7cfca8aeeada45bbdca035f73df269cefdcce61 AS build
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY cmd/mcp-fixture ./cmd/mcp-fixture
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -buildvcs=false -ldflags="-s -w" \
    -o /out/mcp-fixture ./cmd/mcp-fixture

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/mcp-fixture /mcp-fixture
LABEL org.opencontainers.image.title="agent-runtime MCP fixture" \
      org.opencontainers.image.description="Domain-neutral deterministic MCP development fixture"
ENV LISTEN_ADDR=:8085
EXPOSE 8085
USER nonroot:nonroot
ENTRYPOINT ["/mcp-fixture"]
