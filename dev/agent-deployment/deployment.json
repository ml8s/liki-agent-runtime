{
  "schema_version": "agent.deployment.v1",
  "metadata": {
    "name": "agent-runtime-deployment",
    "version": "1.0.0"
  },
  "spec": {
    "mcpServers": [
      {
        "name": "tools-a",
        "endpointEnv": "AGENT_RUNTIME_MCP_TOOLS_A_URL",
        "tokenEnv": "AGENT_RUNTIME_MCP_TOOLS_A_TOKEN"
      },
      {
        "name": "tools-b",
        "endpointEnv": "AGENT_RUNTIME_MCP_TOOLS_B_URL",
        "tokenEnv": "AGENT_RUNTIME_MCP_TOOLS_B_TOKEN"
      }
    ],
    "agents": [
      {
        "name": "main",
        "version": "1.0.0",
        "description": "Generic development agent",
        "mode": "chat",
        "instruction": {
          "path": "instruction.md"
        },
        "tools": {
          "allow": {
            "tools-a": [
              "tool_a_1",
              "tool_a_2",
              "tool_a_3",
              "tool_a_4"
            ],
            "tools-b": [
              "tool_b_1",
              "tool_b_2",
              "tool_b_3"
            ],
            "skilltoolset": [
              "list_skills",
              "load_skill",
              "load_skill_resource"
            ]
          }
        },
        "skills": {
          "root": "/skills"
        }
      }
    ]
  }
}
