{
  "metadata": {
    "name": "liki-agents-deployment",
    "version": "1.0.0"
  },
  "spec": {
    "mcpServers": [
      {
        "name": "engine",
        "endpointEnv": "LIKI_MCP_ENGINE_URL",
        "tokenEnv": "LIKI_MCP_ENGINE_TOKEN"
      },
      {
        "name": "counsel",
        "endpointEnv": "LIKI_MCP_COUNSEL_URL",
        "tokenEnv": "LIKI_MCP_COUNSEL_TOKEN"
      }
    ],
    "agents": [
      {
        "name": "main",
        "version": "1.0.0",
        "description": "Generic development agent",
        "mode": "chat",
        "instruction": {
          "path": "instruction.md"
        },
        "tools": {
          "allow": {
            "engine": [
              "bazi_chart",
              "ziwei_chart",
              "tianwen_time",
              "city_coords"
            ],
            "counsel": [
              "compute_factors",
              "natal_query",
              "period_query"
            ],
            "skilltoolset": [
              "list_skills",
              "load_skill",
              "load_skill_resource"
            ]
          }
        },
        "skills": {
          "root": "/skills"
        }
      }
    ]
  }
}
