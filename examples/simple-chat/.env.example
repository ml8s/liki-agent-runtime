# Local example provider configuration. Copy this file to .env.
# The Compose file forces development mode and disables protocol bearer auth.
# DeepSeek uses DeepSeek's OpenAI-compatible endpoint.
AGENTGO_LLM_PROVIDER=openai
AGENTGO_LLM_BASE_URL=https://api.deepseek.com/v1
AGENTGO_LLM_MODEL=deepseek-chat
AGENTGO_LLM_API_KEY=
