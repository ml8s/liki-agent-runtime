# development | production. Unknown values fail closed.
LIKI_ENV=development
# Only "single" is supported. "multi" fails closed until shared official
# session/task/audit backends and routing are enabled.
LIKI_AGENT_RUNTIME_TOPOLOGY=single
LIKI_AGENT_RUNTIME_PROTOCOL_ADDR=:8083
LIKI_AGENT_RUNTIME_PUBLIC_URL=http://127.0.0.1:8083
# Empty disables bearer auth in development. Production requires a strong token.
LIKI_AGENT_RUNTIME_INTERNAL_TOKEN=
# Operational surface (/readyz /version /metrics). Kept separate from the
# protocol listeners so mutual TLS never gates healthchecks or scrapers.
LIKI_AGENT_RUNTIME_OPS_ADDR=:8085
# Optional mutual-TLS protocol listener (direct connect). Set all four or none;
# a partial set fails startup. Client certificates are verified against
# TLS_CLIENT_CA.
LIKI_AGENT_RUNTIME_TLS_ADDR=
LIKI_AGENT_RUNTIME_TLS_CERT=
LIKI_AGENT_RUNTIME_TLS_KEY=
LIKI_AGENT_RUNTIME_TLS_CLIENT_CA=
# Run-completed callback (Standard Webhooks). The URL routes the notification;
# an empty secret keeps the notifier disabled and logs one warning at startup.
LIKI_AGENT_RUNTIME_CALLBACK_URL=
LIKI_AGENT_RUNTIME_CALLBACK_SECRET=

# Logical MCP servers are declared by AgentDeployment. The gateway owns the
# /engine and /counsel service prefixes; an MCP service owns /mcp and
# /mcp/{domain}. The examples below are direct service-network URLs.
LIKI_MCP_ENGINE_URL=http://127.0.0.1:8081/mcp
LIKI_MCP_COUNSEL_URL=http://127.0.0.1:8086/mcp
# Per-server tokens follow the same LIKI_MCP_<NAME> prefix as the endpoint.
LIKI_MCP_ENGINE_TOKEN=
LIKI_MCP_COUNSEL_TOKEN=

# Execution budgets. The run deadline must exceed the per-call budgets below,
# or those budgets can never be reached inside a run.
LIKI_AGENT_RUNTIME_RUN_TIMEOUT_SECONDS=600
LIKI_AGENT_RUNTIME_MAX_CONCURRENT_RUNS=32
LIKI_AGENT_RUNTIME_SHUTDOWN_TIMEOUT_SECONDS=30
# MCP budgets: the tool-call budget bounds runtime tool invocations; the
# health budget bounds discovery/readiness checks and follows the tool-call
# budget when unset.
LIKI_AGENT_RUNTIME_MCP_TIMEOUT_SECONDS=30
LIKI_AGENT_RUNTIME_MCP_HEALTH_TIMEOUT_SECONDS=

# LLM client: base URL, model, and provider are all required. HTTPS is
# mandatory outside development.
LIKI_AGENT_RUNTIME_LLM_BASE_URL=https://api.deepseek.com/v1
LIKI_AGENT_RUNTIME_LLM_API_KEY=
LIKI_AGENT_RUNTIME_LLM_MODEL=deepseek-flash
# Provider is the audit provenance label and the structured-output mode hint
# ("openai" defaults to json_schema, any other provider to json_object); the
# client is always OpenAI-compatible.
LIKI_AGENT_RUNTIME_LLM_PROVIDER=openai
# The deployment decides whether structured output is used. Leave empty to
# derive the mode from the provider; set json_schema or json_object only to
# override it. A mode without output schemas fails closed.
LIKI_AGENT_RUNTIME_LLM_STRUCTURED_OUTPUT=
LIKI_AGENT_RUNTIME_LLM_TIMEOUT_SECONDS=120
LIKI_AGENT_RUNTIME_LLM_TEMPERATURE=0.2
# Optional model output bound; empty means no cap.
LIKI_AGENT_RUNTIME_LLM_MAX_OUTPUT_TOKENS=

# Image/assembly channels: the runtime image and the assembly image own these
# values (container audit path, artifact path); deployments must not override
# them. Listed for completeness only.
# LIKI_AGENT_RUNTIME_AUDIT_DB_PATH=/data/liki-agent-runtime-audit.db
# LIKI_AGENT_RUNTIME_DEPLOYMENT_FILE=/deployment/deployment.json

# OpenTelemetry traces (standard OTLP environment variables)
# OTEL_SDK_DISABLED=false
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1

LIKI_LOG_FORMAT=json
LIKI_LOG_LEVEL=info
