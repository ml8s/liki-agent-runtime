# development | production. Unknown values fail closed.
AGENT_RUNTIME_ENV=development
# Only "single" is supported. "multi" fails closed until shared official
# session/task/audit backends and routing are enabled.
AGENT_RUNTIME_TOPOLOGY=single
AGENT_RUNTIME_PROTOCOL_ADDR=:8083
AGENT_RUNTIME_PUBLIC_URL=http://127.0.0.1:8083
# Empty disables bearer auth in development. Production requires a strong token.
AGENT_RUNTIME_INTERNAL_TOKEN=
# Operational surface (/readyz /version /metrics). Kept separate from the
# protocol listeners so mutual TLS never gates healthchecks or scrapers.
AGENT_RUNTIME_OPS_ADDR=:8085

# Identity source: trusted_header (default) or oidc. Trusted-header production
# requires AGENT_RUNTIME_INTERNAL_TOKEN. OIDC uses a standard bearer ID token,
# so AGENT_RUNTIME_INTERNAL_TOKEN must be empty in that mode.
AGENT_RUNTIME_IDENTITY_SOURCE=trusted_header
AGENT_RUNTIME_OIDC_ISSUER=
AGENT_RUNTIME_OIDC_AUDIENCE=
AGENT_RUNTIME_OIDC_USERNAME_CLAIM=sub
AGENT_RUNTIME_OIDC_TENANT_CLAIM=
# Optional mutual-TLS protocol listener (direct connect). Set all four or none;
# a partial set fails startup. Client certificates are verified against
# TLS_CLIENT_CA.
AGENT_RUNTIME_TLS_ADDR=
AGENT_RUNTIME_TLS_CERT=
AGENT_RUNTIME_TLS_KEY=
AGENT_RUNTIME_TLS_CLIENT_CA=
# A2A protocol state is separate from append-only audit evidence. Standard A2A
# push callbacks are disabled by default; enabling them permits registered
# public HTTPS webhooks and keeps callback configs in the protocol database.
# AGENT_RUNTIME_PROTOCOL_STATE_DB_PATH=./data/agent-runtime-protocol-state.db
# AGENT_RUNTIME_ADK_SESSION_DB_PATH=./data/agent-runtime-adk-sessions.db
AGENT_RUNTIME_A2A_TENANT=
AGENT_RUNTIME_A2A_PRINCIPAL=agent-runtime
AGENT_RUNTIME_A2A_PUSH_ENABLED=false
AGENT_RUNTIME_A2A_PUSH_TIMEOUT_SECONDS=10
AGENT_RUNTIME_A2A_PUSH_ALLOW_PRIVATE_NETWORKS=false

# Optional terminal A2A task retention. Unset/zero disables cleanup. Audit
# evidence is append-only and is never deleted by this policy.
AGENT_RUNTIME_A2A_TASK_RETENTION_SECONDS=

# Optional idle ADK session retention. Unset/zero disables cleanup; an explicit
# value must be at least the run timeout. Non-terminal A2A contexts are protected.
AGENT_RUNTIME_ADK_SESSION_RETENTION_SECONDS=

# Logical MCP servers are declared by AgentDeployment. These names match the
# generic development fixture; production deployments choose their own names.
AGENT_RUNTIME_MCP_TOOLS_A_URL=http://127.0.0.1:8081/mcp
AGENT_RUNTIME_MCP_TOOLS_B_URL=http://127.0.0.1:8086/mcp
# Per-server tokens follow the same AGENT_RUNTIME_MCP_<NAME> prefix as the endpoint.
AGENT_RUNTIME_MCP_TOOLS_A_TOKEN=
AGENT_RUNTIME_MCP_TOOLS_B_TOKEN=

# Execution budgets. The run deadline must exceed the per-call budgets below,
# or those budgets can never be reached inside a run.
AGENT_RUNTIME_RUN_TIMEOUT_SECONDS=600
AGENT_RUNTIME_MAX_CONCURRENT_RUNS=32
AGENT_RUNTIME_SHUTDOWN_TIMEOUT_SECONDS=30
# MCP budgets: the tool-call budget bounds runtime tool invocations; the
# health budget bounds discovery/readiness checks and follows the tool-call
# budget when unset.
AGENT_RUNTIME_MCP_TIMEOUT_SECONDS=30
AGENT_RUNTIME_MCP_HEALTH_TIMEOUT_SECONDS=

# LLM client: base URL, model, and provider are all required. HTTPS is
# mandatory outside development.
AGENT_RUNTIME_LLM_BASE_URL=https://llm.example.com/v1
AGENT_RUNTIME_LLM_API_KEY=
AGENT_RUNTIME_LLM_MODEL=your-model
# Provider is the audit provenance label and the structured-output mode hint
# ("openai" defaults to json_schema, any other provider to json_object); the
# client is always OpenAI-compatible.
AGENT_RUNTIME_LLM_PROVIDER=openai
# The deployment decides whether structured output is used. Leave empty to
# derive the mode from the provider; set json_schema or json_object only to
# override it. A mode without output schemas fails closed.
AGENT_RUNTIME_LLM_STRUCTURED_OUTPUT=
AGENT_RUNTIME_LLM_TIMEOUT_SECONDS=120
AGENT_RUNTIME_LLM_TEMPERATURE=0.2
# Optional model output bound; empty means no cap.
AGENT_RUNTIME_LLM_MAX_OUTPUT_TOKENS=

# Image/assembly channels: the runtime image and the assembly image own these
# values (container audit path, artifact path); deployments must not override
# them. Listed for completeness only.
# AGENT_RUNTIME_AUDIT_DB_PATH=/data/agent-runtime-audit.db
# AGENT_RUNTIME_DEPLOYMENT_FILE=/deployment/deployment.json

# OpenTelemetry traces (standard OTLP environment variables)
# OTEL_SDK_DISABLED=false
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1

AGENT_RUNTIME_LOG_FORMAT=json
AGENT_RUNTIME_LOG_LEVEL=info
