# development | production. Unknown values fail closed.
AGENTGO_ENV=development
# Only "single" is supported. "multi" fails closed until shared official
# session/task/audit backends and routing are enabled.
AGENTGO_TOPOLOGY=single
AGENTGO_PROTOCOL_ADDR=:8083
AGENTGO_PUBLIC_URL=http://127.0.0.1:8083
# Empty disables bearer auth in development. Production requires a strong token.
AGENTGO_PROTOCOL_TOKEN=
# Operational surface (/livez /readyz /metrics). Kept separate from the
# protocol listeners so mutual TLS never gates healthchecks or scrapers.
AGENTGO_OPS_ADDR=:8085

# Identity source: trusted_header (default) or oidc. Trusted-header production
# requires AGENTGO_PROTOCOL_TOKEN. OIDC uses a standard bearer ID token,
# so AGENTGO_PROTOCOL_TOKEN must be empty in that mode.
AGENTGO_IDENTITY_SOURCE=trusted_header
# Identity mapping on the mutual-TLS listener. certificate (default) maps the
# verified client certificate subject (URI SAN > email SAN > CN) and is
# fail-closed: the peer cannot claim another user via Remote-User headers.
# header is an explicit opt-in for deployments whose mTLS peer is a gateway
# that already authenticated the end user; it requires the TLS listener.
AGENTGO_MTLS_IDENTITY_SOURCE=certificate
AGENTGO_OIDC_ISSUER=
AGENTGO_OIDC_AUDIENCE=
AGENTGO_OIDC_USERNAME_CLAIM=sub
AGENTGO_OIDC_TENANT_CLAIM=
# Metrics are always enabled on the internal ops surface. Profiling is an
# explicit local/internal debugging opt-in and is disabled by default.
AGENTGO_PPROF_ENABLED=
# Optional mutual-TLS protocol listener (direct connect). Set all four or none;
# a partial set fails startup. Client certificates are verified against
# TLS_CLIENT_CA.
AGENTGO_TLS_ADDR=
AGENTGO_TLS_CERT=
AGENTGO_TLS_KEY=
AGENTGO_TLS_CLIENT_CA=
# A2A protocol state is separate from append-only audit evidence. Standard A2A
# push callbacks are disabled by default; enabling them permits registered
# public HTTPS webhooks and keeps callback configs in the protocol database.
# AGENTGO_PROTOCOL_STATE_DB_PATH=./data/agentgo-protocol-state.db
# AGENTGO_ADK_SESSION_DB_PATH=./data/agentgo-adk-sessions.db
AGENTGO_A2A_TENANT=
AGENTGO_A2A_PRINCIPAL=agentgo
AGENTGO_A2A_PUSH_ENABLED=false
AGENTGO_A2A_PUSH_TIMEOUT_SECONDS=10
AGENTGO_A2A_PUSH_ALLOW_PRIVATE_NETWORKS=false

# Optional terminal A2A task retention. Unset/zero disables cleanup. Audit
# evidence is append-only and is never deleted by this policy.
AGENTGO_A2A_TASK_RETENTION_SECONDS=

# Optional idle ADK session retention. Unset/zero disables cleanup; an explicit
# value must be at least the run timeout. Non-terminal A2A contexts are protected.
AGENTGO_ADK_SESSION_RETENTION_SECONDS=

# Logical MCP servers are declared by AgentDeployment. These names match the
# generic development fixture; production deployments choose their own names.
AGENTGO_MCP_TOOLS_A_URL=http://127.0.0.1:8081/mcp
AGENTGO_MCP_TOOLS_B_URL=http://127.0.0.1:8086/mcp
# Per-server tokens follow the same AGENTGO_MCP_<NAME> prefix as the endpoint.
AGENTGO_MCP_TOOLS_A_TOKEN=
AGENTGO_MCP_TOOLS_B_TOKEN=

# Execution budgets. The run deadline must exceed the per-call budgets below,
# or those budgets can never be reached inside a run.
AGENTGO_RUN_TIMEOUT_SECONDS=600
AGENTGO_MAX_CONCURRENT_RUNS=32
AGENTGO_SHUTDOWN_TIMEOUT_SECONDS=30
# MCP budgets: the tool-call budget bounds runtime tool invocations; the
# health budget bounds discovery/readiness checks and follows the tool-call
# budget when unset.
AGENTGO_MCP_TIMEOUT_SECONDS=30
AGENTGO_MCP_HEALTH_TIMEOUT_SECONDS=

# LLM client: base URL, model, and provider are all required. Provider selects
# the ADK model implementation: "openai" (or any OpenAI-compatible value),
# "anthropic" (Claude native API), or "gemini" (Gemini API). HTTPS is
# mandatory outside development.
AGENTGO_LLM_BASE_URL=https://llm.example.com/v1
AGENTGO_LLM_API_KEY=
AGENTGO_LLM_MODEL=your-model
# Provider selects the ADK model implementation and is the audit provenance
# label. Structured-output default: "openai" → json_schema,
# "anthropic"/"gemini" → native (ADK translates genai.Schema directly),
# any other value → json_object (OpenAI-compatible fallback).
AGENTGO_LLM_PROVIDER=openai
# The deployment decides whether structured output is used. Leave empty to
# derive the mode from the provider; set json_schema, json_object, or native
# only to override it. Anthropic and gemini reject non-native modes. A mode
# without output schemas fails closed.
AGENTGO_LLM_STRUCTURED_OUTPUT=
AGENTGO_LLM_TIMEOUT_SECONDS=120
AGENTGO_LLM_TEMPERATURE=0.2
# Optional model output bound; empty means no cap.
AGENTGO_LLM_MAX_OUTPUT_TOKENS=

# Image/assembly channels: the runtime image and the assembly image own these
# values (container audit path, artifact path); deployments must not override
# them. Listed for completeness only.
# AGENTGO_AUDIT_DB_PATH=/data/agentgo-audit.db
# AGENTGO_DEPLOYMENT_FILE=/deployment/deployment.json

# OpenTelemetry traces (standard OTLP environment variables)
# OTEL_SDK_DISABLED=false
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1

AGENTGO_LOG_FORMAT=json
AGENTGO_LOG_LEVEL=info
